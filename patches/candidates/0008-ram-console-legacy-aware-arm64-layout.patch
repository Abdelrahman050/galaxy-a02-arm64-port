+#if defined(CONFIG_ARM64) && !defined(CONFIG_SEC_DEBUG)
+static bool ram_console_reason_layout_valid(const struct ram_console_buffer *buffer)
+{
+	if (!buffer || !ram_console_buffer ||
+	    buffer->sz_buffer != ram_console_buffer->sz_buffer ||
+	    buffer->off_linux < sizeof(*buffer) ||
+	    buffer->off_linux > buffer->sz_buffer ||
+	    buffer->off_console > buffer->sz_buffer ||
+	    buffer->off_console < buffer->off_linux ||
+	    buffer->off_console - buffer->off_linux != A02_REASON_AREA_BYTES ||
+	    buffer->sz_console != buffer->sz_buffer - buffer->off_console)
+		return false;
+	return true;
+}
+
+static bool ram_console_reason_is_native_arm64(const struct ram_console_buffer *buffer)
+{
+	const struct a02_reason_format_tag *tag;
+
+	if (!ram_console_reason_layout_valid(buffer))
+		return false;
+	tag = (const void *)buffer + buffer->off_linux + A02_NATIVE_TAG_OFFSET;
+	return tag->magic == A02_REASON_MAGIC &&
+	       tag->inverse_magic == ~A02_REASON_MAGIC &&
+	       tag->version == A02_REASON_VERSION &&
+	       tag->native_reason_size == sizeof(struct last_reboot_reason);
+}
+
+static void ram_console_mark_native_arm64(struct ram_console_buffer *buffer)
+{
+	struct a02_reason_format_tag *tag =
+		(void *)buffer + buffer->off_linux + A02_NATIVE_TAG_OFFSET;
+
+	tag->magic = A02_REASON_MAGIC;
+	tag->inverse_magic = ~A02_REASON_MAGIC;
+	tag->version = A02_REASON_VERSION;
+	tag->native_reason_size = sizeof(struct last_reboot_reason);
+}
 #endif
 
